# ── Cloudflare Pages Headers ────────────────────────────────────────────────
# https://developers.cloudflare.com/pages/configuration/headers/

# ── All pages ────────────────────────────────────────────────────────────────
/*
  # Force HTTPS for 2 years, include subdomains, allow preload list submission
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

  # Prevent MIME-type sniffing
  X-Content-Type-Options: nosniff

  # Deny rendering in iframes (clickjacking protection)
  X-Frame-Options: DENY

  # Stop legacy XSS filter from triggering (modern browsers ignore this anyway)
  X-XSS-Protection: 0

  # Only send origin as referrer when crossing origins; full URL within same origin
  Referrer-Policy: strict-origin-when-cross-origin

  # Restrict browser feature access
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()

  # Content Security Policy
  # - script-src: 'unsafe-inline' needed for Vite module scripts injected at build time
  # - style-src:  'unsafe-inline' needed for Tailwind JIT + GSAP inline styles
  # - img-src:    allow Behance CDN, Prismic CDN, Sanity CDN, and data URIs
  # - font-src:   Google Fonts files
  # - connect-src: same-origin only (no external XHR/fetch)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://mir-s3-cdn-cf.behance.net https://rejouice-2024.cdn.prismic.io https://cdn.sanity.io; media-src 'self' blob:; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests

  # HTML pages: always revalidate (never serve stale HTML)
  Cache-Control: no-cache, must-revalidate

# ── Hashed JS / CSS bundles (Vite content-hash filenames) ───────────────────
# Safe to cache for 1 year — filename changes on every deploy
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

/assets/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/assets/*.woff
  Cache-Control: public, max-age=31536000, immutable

# ── Static assets in /public (no content hash) ──────────────────────────────
/favicon.svg
  Cache-Control: public, max-age=86400

/opengraph.jpg
  Cache-Control: public, max-age=86400

/reel.mp4
  Cache-Control: public, max-age=604800
  Accept-Ranges: bytes

# ── SEO & crawlers (revalidate daily) ───────────────────────────────────────
/robots.txt
  Cache-Control: public, max-age=86400
  X-Robots-Tag: noindex

/sitemap.xml
  Cache-Control: public, max-age=86400
  Content-Type: application/xml; charset=utf-8

/llms.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

# ── Downloads (long cache, force download) ───────────────────────────────────
/downloads/*
  Cache-Control: public, max-age=604800
